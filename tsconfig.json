{
	"compilerOptions": {
		"target": "es2023",
		"moduleResolution": "bundler",
		"module": "es2022",
		"lib": ["ES2022", "DOM"],
		"types": [],
		"declaration": false,
		"noLib": false,
		"sourceMap": false,
		"pretty": true,
		"forceConsistentCasingInFileNames": true,
		"preserveConstEnums": true,
		"strict": true,
		"noImplicitAny": true,
		"outDir": "scripta",
		"rootDir": "src",
		"allowJs": true,
		"skipLibCheck": true
	},
	"include": ["./src"],
	"compileOnSave": false
}
